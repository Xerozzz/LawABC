# Copy to .env and adjust as needed. Docker Compose reads this automatically.
POSTGRES_USER=lawabc
POSTGRES_PASSWORD=lawabc_password
POSTGRES_DB=lawabc

# Auth
JWT_SECRET=dev-secret-change-me

# Community (peer posts). Closed while testing — there are no moderators yet.
# Set to true to reopen it.
COMMUNITY_ENABLED=false

# Host ports (change these if the defaults are already in use on your machine)
BACKEND_PORT=4000
FRONTEND_PORT=5173
DB_PORT=5432

# --- Pilot study (participation tracking) ---
# Shared secret for /api/admin/*. Leave unset to disable the admin API entirely.
ADMIN_TOKEN=dev-admin-token-change-me
# Length of the study window and the timezone its days are cut on.
STUDY_DAYS=14
STUDY_TZ=Asia/Singapore
# Optional fixed cohort start (YYYY-MM-DD). Unset => each user's 14 days begin
# the day they accept consent.
# STUDY_START_DATE=2026-09-08
