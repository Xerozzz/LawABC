# Single-image production build: compiles the React app and serves it from the
# Express backend (same origin as the API). Build from the repo root:
#   docker build -f Dockerfile.prod -t clearair .

# 1. Build the frontend (no VITE_API_URL => relative "/api" calls)
FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package*.json ./
RUN npm install
COPY frontend/ ./
RUN npm run build

# 2. Backend runtime with the built frontend copied into ./public
FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY backend/package*.json ./
RUN npm install --omit=dev
COPY backend/ ./
COPY --from=frontend /fe/dist ./public
EXPOSE 4000
CMD ["node", "src/index.js"]
