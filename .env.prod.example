# Copy to .env on the server (next to docker-compose.prod.yml). Do NOT commit real secrets.
# Terraform generates these automatically when deploying to AWS.

POSTGRES_USER=clearair
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=clearair

# Long random string used to sign auth tokens.
JWT_SECRET=change-me-to-a-long-random-string

# Seed demo community reflections so the feed isn't empty for testers.
DEMO_SEED=true

# Edge address for Caddy:
#   :80                     -> plain HTTP (default; geolocation on the map won't work without HTTPS)
#   clearair.example.com    -> auto-HTTPS via Let's Encrypt (point the DNS A record at the server first)
SITE_ADDRESS=:80

# --- Pilot study (participation tracking) ---
# Shared secret for /api/admin/*. Leave unset to disable the admin API entirely.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-string
STUDY_DAYS=14
STUDY_TZ=Asia/Singapore
# Optional fixed cohort start (YYYY-MM-DD). Unset => each user's 14 days begin
# the day they accept consent.
# STUDY_START_DATE=2026-09-08
