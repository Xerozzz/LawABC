# Copy to terraform.tfvars and fill in. Do NOT commit terraform.tfvars.

region        = "ap-southeast-1"
instance_type = "t3.small"

# Your public IP so only you can SSH. Find it: curl ifconfig.me  ->  "1.2.3.4/32"
admin_cidr = "1.2.3.4/32"

# Contents of your SSH public key (cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA...replace-me... you@machine"

# App source (must be a PUBLIC repo — the instance clones it with no credentials)
repo_url    = "https://github.com/Xerozzz/LawABC.git"
repo_branch = "main"

# ":80" = plain HTTP. For HTTPS, put your domain here and point its DNS A record
# at the Elastic IP after the first apply (needed for geolocation on the map).
site_address = ":80"
